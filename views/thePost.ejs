<%- include("partials/header.ejs") %>

<div class="page-container">
  <div class="displayArea-not-home">
    <div class="primary">
      <div class="edit-or-post">
        <%if (locals.postID) { %>
          <div class="en-post post-content">
            <h1 class="handwriting title-container"> Edit Post </h1>
            <form class="input-form" action="/update" method="POST">
              <div class="input-text">
                <label for="blogTitle" class="form-label">Blog Title</label>
                <input name="title" type="text" class="form-control mb-2" id="blogTitle" value="<%=title%>">
              </div>
              <div class="input-text">
                <label for="blogText" class="form-label">Blog Text</label>
                <textarea name="text" type="text" class="form-control mb-3" id="blogText" rows="5"><%=text%></textarea>
                <input hidden type="text" name="index" value="<%=postID%>">
              </div>
              <div class="submit-button">
                <input type="submit" class="btn btn-secondary" value="Update Post"/>
              </div>            
            </form>
          </div>
        <%} else { %>
          <div class="en-post post-content">
            <h1 class="handwriting title-container"> New Blog </h1>
            <form class="input-form" action="/submit" method="POST">
              <div class="input-text">
                <label for="blogTitle" class="form-label">Blog Title</label>
                <input name="title" type="text" class="form-control mb-2" id="blogTitle"  placeholder="Title">
              </div>
              <div class="input-text">
                <label for="blogText" class="form-label">Blog Text</label>
                <textarea name="text" class="form-control mb-3" id="blogText" rows="6" placeholder="Start typing here..."></textarea>
              </div>
              <div class="submit-button">
                <input type="submit" class="btn btn-secondary" value="Post"/>
              </div>            
            </form>
          </div>
        <% } %>
      </div>
    </div>
    <div class="secondary">
      <div class="previous-posts">
    <%  if (posts.length===0) {%>
          <div>
            <h5>No posts yet...</h5>
          </div>
    <%} else {%>
          <div>
            <h3 class="handwriting">Get Inspired</h3>
            <hr>
            <ul class="recent-post">
    <%        posts.toReversed().forEach((post) => {%>
                <div class="post-specs">
                  <h6><a href="/view/<%= posts.indexOf(post) %>"><%=post.title%></a></h6>
                  <hr>
                </div>
    <%         }); %>
            </ul>
          </div>
    <%  } %>
      </div>
    </div>  
  </div>
</div>

<%- include("partials/footer.ejs") %>