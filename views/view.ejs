<%- include("partials/header.ejs") %>

<div class="page-container">
  <div class="displayArea not-home">
    <div class="primary">
      <div class="posts-display">
        <h1 class="handwriting"><%= title %></h1>
        <p><%= text %></p>
      </div>
    </div>
    <div class="secondary">
      <div class="editing">
        <a href="/edit/<%=postID%>"><input type="button" class="btn btn-primary" value="Edit"></a>
        <form action="/delete" method="POST">
          <input type="text" name="postID" hidden value="<%=postID%>">
          <input type="submit" class="btn btn-danger" value="Delete">
        </form>
      </div>
      <div class="previous-posts">
      <%  if (posts.length===0) {%>
          <div>
            <h5>No posts yet...</h5>
          </div>
        <%} else {%>
          <div>
            <h3 class="handwriting">Other Posts</h3>
            <ul class="recent-post">
        <%    posts.toReversed().forEach((post) => {%>
                <div class="post-specs">
                  <h6><a href="/view/<%= posts.indexOf(post) %>"><%=post.title%></a></h6>
                </div>
        <%    }); %>
            </ul>
          </div>
      <%  }%>
      </div>
    </div>  
  </div>
</div>

<%- include("partials/footer.ejs") %>